rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Fotos de perfil, serviços e anexos de chat
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /services/{workerId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == workerId;
    }

    match /portfolio/{workerId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == workerId;
    }

    match /chat_attachments/{orderId}/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }

    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
