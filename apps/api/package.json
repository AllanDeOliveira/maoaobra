{
  "name": "@maoaobra/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin:promote": "tsx --env-file=.env src/scripts/promote-admin.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.13",
    "@better-auth/expo": "^1.7.13",
    "@fastify/cors": "^11.3.1",
    "@maoaobra/shared": "workspace:*",
    "better-auth": "^1.7.13",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
