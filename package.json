{
  "name": "maoaobra",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "dev:api": "pnpm --filter @maoaobra/api dev",
    "dev:app": "pnpm --filter @maoaobra/app start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "typescript": "~6.0.3"
  }
}
